{
    "name": "gdpe/gamedog-pedigree-engine",
    "description": "GameDog Pedigree Engine",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GDPE\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GDPE\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
